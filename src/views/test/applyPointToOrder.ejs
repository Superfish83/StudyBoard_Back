<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apply Points to Order</title>
</head>
<body>
    <h1>Apply Points to Order</h1>
    <form id="apply-point-form" method="POST" action="/order/use/point">
        <label for="order_id">Order ID:</label>
        <input type="text" id="order_id" name="order_id" required>
        <br><br>

        <label for="point_amount">Point Amount:</label>
        <input type="number" id="point_amount" name="point_amount" min="1" required>
        <br><br>

        <button type="submit">Apply Points</button>
    </form>

    <script>
        document.getElementById('apply-point-form').addEventListener('submit', async (event) => {
            event.preventDefault();

            const form = event.target;
            const formData = new FormData(form);

            const response = await fetch(form.action, {
                method: form.method,
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(Object.fromEntries(formData)),
            });

            const result = await response.json();

            if (response.ok) {
                alert(`Success: ${result.message}`);
            } else {
                alert(`Error: ${result.message}`);
            }
        });
    </script>
</body>
</html>

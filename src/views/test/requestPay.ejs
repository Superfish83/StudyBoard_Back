<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request Payment</title>
</head>
<body>
    <h1>TDD</h1>
    <form id="reqPaymentForm">
        <label for="order_id">Order ID:</label>
        <input type="text" id="order_id" name="order_id" required>
        <br><br>

        <label for="redirect_to">Redirect To:</label>
        <input type="text" id="redirect_to" name="redirect_to" value="http://localhost:3000/" required>
        <br><br>

        <button type="button" onclick="requestPayment()">Request Pay</button>
    </form>

    <h2>Result</h2>
    <pre id="result"></pre>
    <div id="tokenLink" style="margin-top: 20px;"></div>

    <script>
        async function requestPayment() {
            const form = document.getElementById("reqPaymentForm");
            const formData = new FormData(form);

            const data = {
                order_id: formData.get("order_id"),
                redirect_to: formData.get("redirect_to")
            };

            try {
                // Send POST request to /api/order/payment
                const response = await fetch("/order/payment", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });

                if (!response.ok) {
                    document.getElementById("result").textContent = `Error: ${response.statusText}`;
                    return;
                }

                const result = await response.json();

                if (result.token) {
                    const token = result.token;
                    document.getElementById("result").textContent = `Token: ${token}`;

                    // Create a link to /api/order/payment with the token as a parameter
                    const link = document.createElement("a");
                    link.href = `/order/payment?token=${token}`;
                    link.textContent = "Go to Payment";
                    link.target = "_blank";

                    const tokenLinkDiv = document.getElementById("tokenLink");
                    tokenLinkDiv.innerHTML = ""; // Clear previous links
                    tokenLinkDiv.appendChild(link);
                } else {
                    document.getElementById("result").textContent = "Error: Token not found in response.";
                }
            } catch (error) {
                console.error("Error requesting payment:", error);
                document.getElementById("result").textContent = "Error requesting payment.";
            }
        }
    </script>
</body>
</html>
